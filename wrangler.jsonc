{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stemo-coding",
  "compatibility_date": "2026-01-02",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stemo-db",
      "database_id": "ea9e6835-ab5b-4161-9268-d70b03166543"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
