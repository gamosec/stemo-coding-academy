{
  "name": "stemo-coding-academy",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "validate:curriculum": "node scripts/validate-curriculum.mjs",
    "test:curriculum": "node scripts/test-curriculum-validator.mjs",
    "test:progress": "npm run test:progress:api && npm run test:progress:d1 && npm run test:progress:client",
    "test:progress:api": "node scripts/test-progress-reset-api.mjs",
    "test:progress:d1": "node scripts/test-progress-reset-d1.mjs",
    "test:progress:client": "node scripts/test-progress-client-invariants.mjs",
    "build": "npm run validate:curriculum && vite build",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy dist",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.11.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250705.0",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-cloudflare-pages": "^0.4.3",
    "@hono/vite-dev-server": "^0.18.2",
    "typescript": "^5.0.0",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
